{
  "name": "@laskaridis/afk",
  "version": "0.3.1",
  "description": "Run a coding agent (Codex, Claude Code) unattended, one task per fresh session",
  "type": "module",
  "bin": {
    "afk": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laskaridis/afk.git"
  },
  "homepage": "https://github.com/laskaridis/afk#readme",
  "bugs": {
    "url": "https://github.com/laskaridis/afk/issues"
  }
}
